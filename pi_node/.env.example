# Copy to pi_node/.env on the Raspberry Pi. (run_local.py sets these for you on a PC.)

# real = HX711 + Grove sensors + USB webcam on the Pi; sim = simulated fridge on any computer
PI_HARDWARE=real
# sim mode only: "sim" draws a synthetic fridge, "webcam" uses this computer's camera
PI_CAMERA=sim

# The computer running main.py (FastAPI + vision + AI). Use its LAN IP.
BACKEND_URL=http://192.168.1.50:8000

# One DT:SCK pair per shelf, BCM numbering. With a Grove Base Hat, a digital
# port Dn carries GPIO n and n+1 — e.g. HX711 on port D16 -> 16:17.
HX711_PINS=16:17,18:19

# Grove Micro Switch v1.0 on port D5 (signal = GPIO5)
DOOR_SWITCH_PIN=5
# Mount the switch so the closed door presses it (true), or the reverse (false)
DOOR_CLOSED_WHEN_PRESSED=true

# Grove Light Sensor v1.2 on analog port A0 of the Base Hat
LIGHT_ADC_CHANNEL=0
# Optional: treat light above this as "door open" too (fridge light on) — a backup
# for the micro switch. Leave blank until you've seen readings with door open/closed.
DOOR_LIGHT_THRESHOLD=

# Grove barometer on any I2C port. Blank = auto-detect at 0x77 then 0x76.
BAROMETER_I2C_ADDRESS=

# USB webcam
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# The backend fetches frames from http://<pi>:CAMERA_PORT/frame.jpg (set PI_AGENT_URL there)
CAMERA_PORT=8001

WEIGHT_PUSH_HZ=10
CONDITIONS_PUSH_S=30
