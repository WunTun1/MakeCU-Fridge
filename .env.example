# Backend (the computer). Copy to .env. Nothing here is required for a demo —
# missing keys fall back to placeholder AI responses, and run_local.py sets the
# hardware settings below for you when testing on one machine.

# Chatbot + new-item naming (Google Gemini: function calling + vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nutrition lookups (Open Food Facts needs no key)
USDA_FDC_API_KEY=

# --- Fridge hardware ---------------------------------------------------------
# Where weights + door state come from:
#   network = the Raspberry Pi (or run_local.py's simulated Pi) pushes to /api/pi/*
#   mock    = nothing attached; app runs off seeded data
#   serial  = legacy ESP32 over USB (firmware/scale_esp32)
SCALE_SOURCE=mock
NUM_SHELVES=2
# The Pi node's camera server. Unset = use a webcam plugged into this computer.
PI_AGENT_URL=http://raspberrypi.local:8001
# Run the vision + fusion loop (needs a camera source and SCALE_SOURCE != mock)
ENABLE_FRIDGE_LOOP=false
# Optional: which vertical band of the camera image each shelf occupies
# SHELF_BANDS=0-0.5,0.5-1

# serial source only
SCALE_SERIAL_PORT=COM3
CAMERA_INDEX=0

# --- Backend ----------------------------------------------------------------
DATABASE_PATH=refridge.db
API_HOST=0.0.0.0
API_PORT=8000
